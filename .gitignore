lib/generated_plugin_registrant.dart

# Symbolication / Obfuscation
app.*.symbols
app.*.map.json

# --- Plugin Specific Rules ---
# Do not commit pubspec.lock for library packages (root)
pubspec.lock

# DO commit pubspec.lock for the example app to ensure reproducible CI
!example/pubspec.lock