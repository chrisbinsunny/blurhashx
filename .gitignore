!**/ios/**/*.xcworkspace/xcshareddata/
!**/ios/**/*.xcworkspace/default.xcworkspace/
!**/macos/**/*.xcworkspace/xcshareddata/
!**/macos/**/*.xcworkspace/default.xcworkspace/

